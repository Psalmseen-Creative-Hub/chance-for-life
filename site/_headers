# HTTP headers applied at the edge.
# Read automatically by Cloudflare Pages (and Netlify), so this file
# stays useful if the site ever moves between them.

/*
  # Don't allow the site to be embedded in a frame elsewhere (clickjacking)
  X-Frame-Options: DENY
  # Don't let browsers guess a file's type from its contents
  X-Content-Type-Options: nosniff
  # Send the full referrer to our own pages, only the origin to other sites
  Referrer-Policy: strict-origin-when-cross-origin
  # We don't use these, so switch them off explicitly
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
